# ─── apps/api ─────────────────────────────────────────────────────────────────
# Postgres connection (matches infra/docker-compose.yml)
DATABASE_URL="postgresql://ticketz:ticketz@localhost:5432/ticketz?schema=public"

# Auth (hand-rolled JWT). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Stripe (test mode) — added in Epic 6
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# CORS allowlist for the web origin
WEB_ORIGIN="http://localhost:3001"

# ─── apps/web ─────────────────────────────────────────────────────────────────
# Browser-visible GraphQL endpoint
NEXT_PUBLIC_GRAPHQL_URL="http://localhost:3000/graphql"
# Server-only endpoint used by RSC / Server Actions (can differ in prod/docker)
GRAPHQL_INTERNAL_URL="http://localhost:3000/graphql"
# Stripe publishable key (test) — added in Epic 6
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
